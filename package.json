{
  "name": "universities",
  "version": "0.2.0",
  "description": "Comprehensive worldwide universities dataset with TypeScript API, CLI tools, and data processing utilities. Includes web scraping capabilities with respectful rate limiting for enriching university data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "universities": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "world-universities.csv",
    "docs/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "ts-node ./src/index.ts",
    "build": "./scripts/build.sh",
    "build:publish": "npm run build:tsc && npm run verify:dist && npm run lint && npm run format:check && npm run test",
    "build:tsc": "rimraf dist && tsc -p tsconfig.build.json && node scripts/buildEsm.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "docs": "ts-node ./scripts/buildDocsSite.ts",
    "docs:generate": "ts-node ./scripts/buildDocsSite.ts",
    "clean": "rimraf dist coverage site",
    "generate:data": "ts-node ./scripts/generateBaseData.ts",
    "enrich": "ts-node ./scripts/enrich.ts",
    "sync:us": "ts-node ./scripts/syncUsFromIpeds.ts",
    "validate:data": "ts-node ./scripts/validateData.ts",
    "check": "npm install && npm run build && npm run format && npm run lint && npm run test:coverage",
    "prepare": "npm run build:tsc",
    "prepublishOnly": "npm run build:publish",
    "verify:dist": "node scripts/verifyDist.js",
    "enrich:snapshot": "ts-node ./scripts/enrich.ts --snapshot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaporjawn/universities.git"
  },
  "keywords": [
    "university",
    "universities",
    "college",
    "colleges",
    "education",
    "higher-education",
    "academic",
    "institutions",
    "dataset",
    "csv",
    "scraping",
    "typescript",
    "api",
    "cli",
    "data-processing",
    "research",
    "global",
    "worldwide",
    "metadata",
    "enrichment"
  ],
  "author": "Vaporjawn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Vaporjawn/universities/issues"
  },
  "homepage": "https://github.com/Vaporjawn/universities#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/nock": "^11.1.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "markdown-it": "^15.0.3",
    "nock": "^15.0.6",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "csv-parser": "^3.2.1",
    "fs-extra": "^11.4.1",
    "p-limit": "^7.3.3",
    "p-queue": "^10.0.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "module": "dist/esm/index.mjs"
}
